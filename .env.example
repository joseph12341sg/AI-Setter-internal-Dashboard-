# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash QStash
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Webhook verification secrets
CLOSE_WEBHOOK_SECRET=your-close-webhook-secret
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# Encryption key for per-workspace API keys stored in DB (32-byte hex)
ENCRYPTION_KEY=your-64-char-hex-string

# App URL (used by QStash to call back into our API routes)
NEXT_PUBLIC_APP_URL=http://localhost:3000
